<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.PasoAPaso" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.PasoAPaso" parent="Base.Theme.PasoAPaso" />
    <style name="Heading">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
